rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validRole(role) {
      return role in ['admin', 'advisor'];
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdvisorOrAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'advisor'];
    }

    function legacyModuleEnabled(moduleId) {
      return !exists(/databases/$(database)/documents/workspace/$(moduleId));
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if isAdmin()
        && request.auth.uid != userId
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'department', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && validRole(request.resource.data.role)
        && request.resource.data.department is string
        && request.resource.data.department.size() <= 60;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'department', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && validRole(request.resource.data.role)
        && request.resource.data.department is string
        && request.resource.data.department.size() <= 60
        && (request.auth.uid != userId || request.resource.data.role == resource.data.role);
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /workspace/{moduleId} {
      allow get: if moduleId in ['portal', 'shifts', 'speeches'] && isAdvisorOrAdmin();
      allow list: if false;
      allow create, update: if moduleId in ['portal', 'shifts', 'speeches']
        && isAdmin()
        && request.resource.data.keys().hasAll(['items', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /portal/{postId} {
      allow read: if isAdvisorOrAdmin() && legacyModuleEnabled('portal');
      allow create, update, delete: if false;
    }

    match /shifts/{shiftId} {
      allow read: if isAdvisorOrAdmin() && legacyModuleEnabled('shifts');
      allow create, update, delete: if false;
    }

    match /suggestions/{suggestionId} {
      allow create: if isAdvisorOrAdmin()
        && request.resource.data.keys().hasOnly(['text', 'uid', 'email', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.text.size() <= 2000
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
